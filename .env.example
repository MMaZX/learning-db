MCP_SERVER_NAME=db-intelligence
MCP_LOG_LEVEL=info

# Transporte: "stdio" (default, un proceso por cliente) o "http" (Streamable
# HTTP, soporta múltiples sesiones/clientes concurrentes sobre un mismo
# proceso). En "http", MCP_AUTH_TOKEN es obligatorio.
MCP_TRANSPORT=stdio
MCP_HTTP_ADDR=127.0.0.1:8080
MCP_AUTH_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=database_multi_final
DB_USERNAME=sigea_mcp_auditor
DB_PASSWORD=

MCP_QUERY_TIMEOUT=10s
MCP_MAX_ROWS=1000
MCP_MAX_COLUMNS=100
MCP_MAX_RESULT_SIZE=5MB
MCP_MAX_CONCURRENT_QUERIES=5
MCP_SLOW_QUERY_THRESHOLD=2s

MCP_EXCLUDED_TABLES=
MCP_EXCLUDED_COLUMNS=password,token,secret,pass,contrasena,contraseña

MCP_KNOWLEDGE_PATH=./knowledge
MCP_DATA_PATH=./data
