# Variante de Granite 4.1 3B para Jarvis. Crear con:
#   ollama create jarvis-granite -f scripts/ollama/jarvis-granite.Modelfile
#
# num_ctx: la API OpenAI-compatible (la que usa OmniRoute) no permite fijar el contexto por
# petición. Jarvis necesita ~4.1K tokens de system prompt + 20 tools, más el resultado de
# cada tool (el BFF los recorta con CHAT_MAX_TOOL_RESULT_BYTES). La RTX 3050 deja 3.68 GiB
# utilizables y comparte la GPU con la voz (RVC en GPU, ~650 MiB; Kokoro va en CPU). Medido
# 2026-09-23 con KV cache q8_0 (override de systemd): 16K ocupa 2.76 GB y el total con la voz
# sintetizando queda en 3.5 GB. Si la voz vuelve a GPU completa (~1.2 GB), 16K ya no cabe.
FROM granite4.1:3b
PARAMETER num_ctx 16384
# El reparto automático de Ollama reserva de más y deja parte del modelo en CPU, lo que
# hunde la generación. Todo el modelo cabe en la GPU.
PARAMETER num_gpu 99
